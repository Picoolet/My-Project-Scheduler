{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++.exe 生成活动文件",
			"command": "D:\\mingw64\\bin\\g++.exe",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"-fexec-charset=GBK",
				"-I", "${workspaceFolder}/model",
				"-I", "${workspaceFolder}/service",
				"-I", "${workspaceFolder}/view",
				"${workspaceFolder}/model/*.cpp",
				"${workspaceFolder}/service/*.cpp",
				"${workspaceFolder}/view/*.cpp",
				"${workspaceFolder}/main.cpp",
				"-o",
				"${workspaceFolder}\\main.exe"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "编译器: D:\\mingw64\\bin\\g++.exe"
		}
	]
}